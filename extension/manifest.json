{
  "manifest_version": 3,
  "name": "ESSMT Mail Overlay — Synthetic Demo",
  "version": "0.2.0",
  "description": "Independent read-only mail tag overlay for the local synthetic ESSMT demo.",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "identity.js",
        "bridge.js",
        "adapters.js",
        "provider.js",
        "content.js"
      ],
      "css": [
        "badges.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html"
}
